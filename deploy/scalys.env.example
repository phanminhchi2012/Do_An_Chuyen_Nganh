SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://127.0.0.1:5432/scalys
DB_USERNAME=CHANGE_ME
DB_PASSWORD='CHANGE_ME'
ADMIN_USERNAME=CHANGE_ME
ADMIN_PASSWORD_HASH='REPLACE_WITH_A_REAL_BCRYPT_HASH'
# Keep uploads outside the source tree and include both directories in backups.
PRODUCT_IMAGE_STORAGE_DIR=/opt/scalys/local-product-images
WARRANTY_STORAGE_DIR=/opt/scalys/local-warranty-videos
# Only enable VNPAY after registering the merchant and public HTTPS IPN endpoint.
# VNPAY_TMN_CODE=YOUR_MERCHANT_CODE
# VNPAY_HASH_SECRET='YOUR_SECRET_FROM_VNPAY'
# VNPAY_PAY_URL=URL_PROVIDED_BY_VNPAY_FOR_THIS_ENVIRONMENT
# VNPAY_RETURN_URL=https://shop.example.com/orders/payment-result
# VNPAY_IPN_URL=https://shop.example.com/api/payments/vnpay/ipn
# ZaloPay sandbox stays on the sandbox API even with the prod Spring profile.
# ZALOPAY_APP_ID=YOUR_SANDBOX_APP_ID
# ZALOPAY_KEY1='YOUR_SANDBOX_KEY1'
# ZALOPAY_KEY2='YOUR_SANDBOX_KEY2'
# ZALOPAY_RETURN_URL=https://shop.example.com/orders/zalopay-result
# Public shop address used in order emails.
# SHOP_PUBLIC_URL=https://shop.example.com
# Enable email after filling all SMTP settings and testing a real delivery.
# SHOP_MAIL_ENABLED=true
# SHOP_MAIL_FROM=shop@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=shop@example.com
# SMTP_PASSWORD='YOUR_SMTP_APP_PASSWORD'
